---
layout: null
sitemap: false
permalink: /search-index.json
---
{%- assign counter = 0 -%}[
{%- for page in site.pages -%}{%- unless page.url contains '.xml' or page.url contains 'assets' or page.url contains 'search-index' -%}
{
    "id": {{ counter }},
    "url": {{ page.url | prepend: site.baseurl | prepend: site.url | jsonify }},
    "title": {{ page.title | normalize_whitespace | jsonify }},
    "body": {% capture _b %}{{ page.content | markdownify | replace: '.', '. ' | replace: '</h2>', ': ' | replace: '</h3>', ': ' | replace: '</h4>', ': ' | replace: '</p>', ' ' | strip_html | normalize_whitespace }}{% endcapture %}{{ _b | jsonify }}{% assign counter = counter | plus: 1 %}
    },
{%- endunless -%}{%- endfor -%}
{%- for post in site.posts -%}
{
    "id": {{ counter }},
    "url": {{ post.url | prepend: site.baseurl | prepend: site.url | jsonify }},
    "title": {{ post.title | normalize_whitespace | jsonify }},
    "body": {% capture _b %}{{ post.date | date: '%Y/%m/%d' }} - {{ post.content | markdownify | replace: '.', '. ' | replace: '</h2>', ': ' | replace: '</h3>', ': ' | replace: '</h4>', ': ' | replace: '</p>', ' ' | strip_html | normalize_whitespace }}{% endcapture %}{{ _b | jsonify }}{% assign counter = counter | plus: 1 %}
    }{% if forloop.last %}{% else %},{% endif %}
{%- endfor -%}]
